{
  "name": "@chamly/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/apps/api/src/main.js",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test test/engine.test.ts test/deck-csv.test.ts",
    "test:integration": "npm run build && tsx --test test/integration.test.ts"
  },
  "dependencies": {
    "@chamly/shared": "*",
    "@nestjs/common": "^11.2.4",
    "@nestjs/core": "^11.2.4",
    "@nestjs/platform-express": "^11.2.4",
    "@nestjs/platform-socket.io": "^11.2.4",
    "@nestjs/websockets": "^11.2.4",
    "mysql2": "^3.14.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "socket.io": "^4.8.1",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.20.0",
    "typescript": "~5.9.2",
    "socket.io-client": "^4.8.1"
  }
}
