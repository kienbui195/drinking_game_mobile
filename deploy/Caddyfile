:80 {
    encode zstd gzip

    handle /socket.io/* {
        reverse_proxy api:45100
    }

    handle /health {
        reverse_proxy api:45100
    }

    handle /sessions {
        reverse_proxy api:45100
    }

    handle /auth/* {
        reverse_proxy api:45100
    }

    handle {
        root * /srv
        header /index.html Cache-Control "no-cache"
        try_files {path} /index.html
        file_server
    }
}
